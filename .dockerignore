# Keep the build context small and the image clean. uv recreates the venv and
# bytecode inside the image, and the scratch outputs / notes are never needed.
.venv/
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/

.git/
.gitignore

# Ad-hoc analysis exports and notes — not part of the server.
data/
*.org
notes.org
plot_*.py

# Editor / OS cruft
.DS_Store
*.swp
